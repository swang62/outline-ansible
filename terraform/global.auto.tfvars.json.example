{
  "aws_region": "ap-southeast-1",
  "instance_name": "outline-ec2",
  "instance_type": "t3.small",
  "ssh_public_key_path": "~/.ssh/outline-ec2.pub",
  "cloudflare_zone": "domain.xyz",
  "cloudflare_dns_name": "connect",
  "outline_api_port": 50443,
  "outline_keys_port": 8443,
  "outline_prefix": "%13%03%03%3F",
  "outline_image": "quay.io/outline/shadowbox:stable",
  "outline_dir": "/opt/outline",
  "xui_image": "ghcr.io/mhsanaei/3x-ui:latest",
  "xui_dir": "/opt/3x-ui",
  "xui_panel_hostname": "3xui.domain.xyz",
  "xui_wg_hostname": "connect.domain.xyz",
  "xui_panel_port": 443,
  "xui_amneziawg_port": 3389
}
